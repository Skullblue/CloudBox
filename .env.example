# Copy to .env (install.sh does this for you)
# CLOUDBOX_PASSWORD is only the first-start password. The app stores a hashed copy in its data volume
# and the installer removes this line afterwards. Change it later from the dashboard or with: sudo cloudbox reset-password
CLOUDBOX_PASSWORD=change-me
CLOUDBOX_SECRET=generate-a-long-random-string
NGROK_AUTHTOKEN=your-ngrok-authtoken
# Disk holding the host's root filesystem (never offered or mounted), e.g. sda or nvme0n1
ROOT_DISK=
